{
  "name": "webgridplus",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:e2e:smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium tests/e2e/basic.spec.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "prepare": "husky",
    "precommit": "npm run typecheck && npm run test:unit",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e:smoke"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "argon2": "^0.44.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.2",
    "typescript": "~5.6.2",
    "vitest": "^2.1.1"
  }
}
